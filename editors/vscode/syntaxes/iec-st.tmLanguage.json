{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "IEC 61131-3 Structured Text",
  "scopeName": "source.iec-st",
  "patterns": [
    { "include": "#comments" },
    { "include": "#pragmas" },
    { "include": "#strings" },
    { "include": "#literals" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#addresses" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.block.st", "begin": "\\(\\*", "end": "\\*\\)" },
        { "name": "comment.block.st", "begin": "/\\*", "end": "\\*/" },
        { "name": "comment.line.double-slash.st", "match": "//.*$" }
      ]
    },
    "pragmas": {
      "patterns": [
        { "name": "meta.preprocessor.st", "begin": "\\{", "end": "\\}" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.st", "begin": "'", "end": "'",
          "patterns": [{ "name": "constant.character.escape.st", "match": "\\$(?:[0-9A-Fa-f]{2}|.)" }]
        },
        {
          "name": "string.quoted.double.st", "begin": "\"", "end": "\"",
          "patterns": [{ "name": "constant.character.escape.st", "match": "\\$(?:[0-9A-Fa-f]{4}|.)" }]
        }
      ]
    },
    "literals": {
      "patterns": [
        { "name": "constant.language.boolean.st", "match": "(?i)\\b(TRUE|FALSE|NULL)\\b" },
        { "name": "constant.numeric.time.st", "match": "(?i)\\b(L?T|L?TIME|L?D|L?DATE|L?TOD|L?TIME_OF_DAY|L?DT|L?DATE_AND_TIME)#[-0-9a-z_:.]+" },
        { "name": "constant.numeric.typed.st", "match": "\\b[A-Za-z_][A-Za-z0-9_]*#[-+]?[0-9A-Fa-f_.]+(?:[eE][-+]?[0-9]+)?\\b" },
        { "name": "constant.numeric.based.st", "match": "\\b(2|8|16)#[0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.st", "match": "\\b[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][-+]?[0-9]+)?\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.st",
          "match": "(?i)\\b(PROGRAM|END_PROGRAM|FUNCTION_BLOCK|END_FUNCTION_BLOCK|FUNCTION|END_FUNCTION|METHOD|END_METHOD|INTERFACE|END_INTERFACE|PROPERTY|END_PROPERTY|TYPE|END_TYPE|STRUCT|END_STRUCT|UNION|END_UNION|CONFIGURATION|END_CONFIGURATION|RESOURCE|END_RESOURCE|TASK|NAMESPACE|END_NAMESPACE|TEST|END_TEST|VAR|VAR_INPUT|VAR_OUTPUT|VAR_IN_OUT|VAR_TEMP|VAR_GLOBAL|VAR_EXTERNAL|VAR_STAT|VAR_INST|VAR_CONFIG|END_VAR|CONSTANT|RETAIN|NON_RETAIN|PERSISTENT|AT|EXTENDS|IMPLEMENTS|ABSTRACT|FINAL|PUBLIC|PRIVATE|PROTECTED|INTERNAL|OVERRIDE|REF_TO|POINTER|REFERENCE|ARRAY|OF|WITH|ON)\\b"
        },
        {
          "name": "keyword.control.st",
          "match": "(?i)\\b(IF|THEN|ELSIF|ELSE|END_IF|CASE|END_CASE|FOR|TO|BY|DO|END_FOR|WHILE|END_WHILE|REPEAT|UNTIL|END_REPEAT|EXIT|CONTINUE|RETURN|JMP)\\b"
        },
        { "name": "variable.language.st", "match": "(?i)\\b(THIS|SUPER)\\b" },
        { "name": "support.function.test.st", "match": "(?i)\\b(ASSERT_TRUE|ASSERT_FALSE|ASSERT_EQ|ASSERT_NE|ADVANCE)\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.st",
          "match": "(?i)\\b(BOOL|SINT|INT|DINT|LINT|USINT|UINT|UDINT|ULINT|REAL|LREAL|BYTE|WORD|DWORD|LWORD|TIME|LTIME|DATE|LDATE|TIME_OF_DAY|TOD|LTOD|DATE_AND_TIME|DT|LDT|CHAR|WCHAR|STRING|WSTRING|ANY|ANY_NUM|ANY_INT|ANY_REAL|ANY_BIT)\\b"
        },
        {
          "name": "support.class.st",
          "match": "(?i)\\b(TON|TOF|TP|R_TRIG|F_TRIG|CTU|CTD|CTUD|SR|RS)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.word.st", "match": "(?i)\\b(AND|OR|XOR|NOT|MOD|AND_THEN|OR_ELSE)\\b" },
        { "name": "keyword.operator.st", "match": ":=|=>|<>|<=|>=|\\*\\*|[-+*/<>=^&]" }
      ]
    },
    "addresses": {
      "patterns": [
        { "name": "variable.other.address.st", "match": "%[IQM][XBWDL]?[0-9.*]*" }
      ]
    }
  }
}
