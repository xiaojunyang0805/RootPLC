(* Tc3_EventLogger compatibility library for RootPLC (see library.toml).

   Written from the public library manual (TE1000 PLC Library:
   Tc3_EventLogger, version 1.6.2). RootPLC has no TwinCAT EventLogger
   service, so the blocks that talk to it are declared but not implemented
   (library.toml declare_only): calls type-check and give warning RP0120, and
   running one stops with UNSUPPORTED. FB_TcSourceInfo holds data only and is
   implemented, except ResetToDefault (it needs the instance's symbol name).

   Differences from the manual, all because the manual does not publish the
   definition:
   - interfaces used only as parameter or property types (filter
     expressions, remote logger, listener context, export settings) are
     declared without members;
   - FB_TcEventFilter has only the members the manual lists;
     FB_TcClearLoggedEventsSettings lacks SetLimit / SetSorting; the remote
     logger blocks and the ADS error conversions (E_AdsErr,
     E_HRESULTAdsErr) are left out;
   - sName of the source information is STRING(255): the manual's
     STRING(ParameterList.cSourceNameSize - 1) with the default size 256.
   TC_EVENTS is generated by TwinCAT from the project's event classes and
   is not part of this library. *)

{attribute 'qualified_only'}
TYPE TcEventSeverity : (
    Verbose  := 0,
    Info     := 1,
    Warning  := 2,
    Error    := 3,
    Critical := 4);
END_TYPE

{attribute 'qualified_only'}
TYPE TcEventConfirmationState : (
    NotSupported := 0,
    NotRequired  := 1,
    WaitForConfirmation := 2,
    Confirmed := 3,
    Reset     := 4);
END_TYPE

TYPE TcEventEntry :
STRUCT
    uuidEventClass : GUID;
    nEventId       : UDINT;
    eSeverity      : TcEventSeverity;
END_STRUCT
END_TYPE

VAR_GLOBAL CONSTANT
    EMPTY_EVENT_CLASS : GUID := (Data1 := 16#0, Data2 := 16#0, Data3 := 16#0, Data4 := [16#0, 16#0, 16#0, 16#0, 16#0, 16#0, 16#0, 16#0]);
    EMPTY_EVENT_ID    : UDINT := 16#0;
    EMPTY_SEVERITY    : TcEventSeverity := TcEventSeverity#Verbose;
    SUCCESS_EVENT     : TcEventEntry := (uuidEventClass := EMPTY_EVENT_CLASS, nEventId := EMPTY_EVENT_ID, eSeverity := EMPTY_SEVERITY);
    stLibVersion_Tc3_EventLogger : ST_LibVersion;
END_VAR

NAMESPACE GVL
VAR_GLOBAL
    nLangId_OnlineMonitoring : DINT := 1033;
END_VAR
END_NAMESPACE

NAMESPACE ParameterList
VAR_GLOBAL CONSTANT
    cSourceNameSize : UDINT(81..10000) := 256;
END_VAR
END_NAMESPACE

