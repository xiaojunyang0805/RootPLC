FUNCTION_BLOCK FB_TcSourceInfo IMPLEMENTS I_TcSourceInfo
VAR
    _guid  : GUID;
    _nId   : UDINT;
    _sName : STRING(255);
END_VAR
METHOD Clear
VAR
    empty : GUID;
END_VAR
_guid := empty;
_nId := 0;
_sName := '';
END_METHOD
METHOD ExtendName : BOOL
VAR_INPUT
    sExtension : STRING(255);
END_VAR
ExtendName := LEN(_sName) + LEN(sExtension) <= 255;
_sName := CONCAT(_sName, sExtension);
END_METHOD
METHOD ResetToDefault
END_METHOD
METHOD EqualsTo : BOOL
VAR_INPUT
    ipOther : I_TcSourceInfo;
END_VAR
VAR
    g : GUID;
    i : INT;
END_VAR
IF ipOther = 0 THEN
    RETURN;
END_IF
g := ipOther.guid;
EqualsTo := g.Data1 = _guid.Data1 AND g.Data2 = _guid.Data2 AND g.Data3 = _guid.Data3
    AND ipOther.nId = _nId AND ipOther.sName = _sName;
FOR i := 0 TO 7 DO
    EqualsTo := EqualsTo AND g.Data4[i] = _guid.Data4[i];
END_FOR
END_METHOD
PROPERTY guid : GUID
GET
    guid := _guid;
END_GET
SET
    _guid := guid;
END_SET
END_PROPERTY
PROPERTY nId : UDINT
GET
    nId := _nId;
END_GET
SET
    _nId := nId;
END_SET
END_PROPERTY
PROPERTY sName : STRING(255)
GET
    sName := _sName;
END_GET
SET
    _sName := sName;
END_SET
END_PROPERTY
END_FUNCTION_BLOCK

